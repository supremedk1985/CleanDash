    "@fontsource/roboto": "^5.2.6",
    "@iobroker/socket-client": "^5.0.2",
    "@iobroker/types": "^7.0.7",
    "@mdi/font": "^7.4.47",
    "@mdi/js": "^7.4.47",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "autoprefixer": "^10.4.21",
    "chart.js": "^4.5.0",
    "postcss": "^8.5.32",
    "primeicons": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "^7.1.2",
    "vitest": "^4.1.10",
    "vue": "^3.5.18",
    "vue-tsc": "^3.0.5"
  }

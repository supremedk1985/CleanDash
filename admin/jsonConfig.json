{
  "i18n": true,
  "type": "tabs",
  "items": {
    "general": {
      "type": "panel",
      "label": "General",
      "items": {
        "title": {
          "type": "text",
          "label": "Title",
          "help": "Shown at the top of the dashboard. Empty: no title",
          "xs": 12,
          "md": 6
        },
        "confirmWrites": {
          "type": "select",
          "label": "Ask before switching",
          "options": [
            {
              "label": "Always",
              "value": "all"
            },
            {
              "label": "Only for several devices at once",
              "value": "bulk"
            }
          ],
          "xs": 12,
          "md": 6,
          "newLine": true
        },
        "theme": {
          "type": "select",
          "label": "Light or dark",
          "help": "Automatic uses sunrise and sunset at the location set in the ioBroker system settings",
          "options": [
            {
              "label": "Automatic",
              "value": "auto"
            },
            {
              "label": "Light",
              "value": "light"
            },
            {
              "label": "Dark",
              "value": "dark"
            }
          ],
          "xs": 12,
          "md": 6
        },
        "openLink": {
          "type": "staticLink",
          "label": "Open dashboard",
          "href": "/cleandash/index.html",
          "button": true,
          "newLine": true
        }
      }
    },
    "rooms": {
      "type": "panel",
      "label": "Rooms",
      "items": {
        "roomsHint": {
          "type": "staticText",
          "text": "One row per room. Every datapoint is optional; leave out what the room does not have.",
          "xs": 12
        },
        "rooms": {
          "type": "table",
          "xs": 12,
          "noDelete": false,
          "items": [
            {
              "type": "text",
              "attr": "name",
              "title": "Name",
              "width": "12%",
              "filter": false,
              "sort": false,
              "default": ""
            },
            {
              "type": "text",
              "attr": "floor",
              "title": "Floor",
              "width": "8%",
              "filter": false,
              "sort": false,
              "default": ""
            },
            {
              "type": "objectId",
              "attr": "temperature",
              "title": "Temperature",
              "width": "14%",
              "filter": false,
              "sort": false,
              "default": ""
            },
            {
              "type": "objectId",
              "attr": "setpoint",
              "title": "Setpoint",
              "width": "14%",
              "filter": false,
              "sort": false,
              "default": ""
            },
            {
              "type": "objectId",
              "attr": "humidity",
              "title": "Humidity",
              "width": "12%",
              "filter": false,
              "sort": false,
              "default": ""
            },
            {
              "type": "objectId",
              "attr": "heating",
              "title": "Heating active (valve)",
              "width": "12%",
              "filter": false,
              "sort": false,
              "default": ""
            },
            {
              "type": "objectId",
              "attr": "window",
              "title": "Window",
              "width": "14%",
              "filter": false,
              "sort": false,
              "default": ""
            },
            {
              "type": "select",
              "attr": "windowMode",
              "title": "Window value",
              "width": "10%",
              "filter": false,
              "sort": false,
              "default": "contact",
              "options": [
                {
                  "label": "Contact (true = open)",
                  "value": "contact"
                },
                {
                  "label": "Handle (0 closed, 1 tilted, 2 open)",
                  "value": "handle"
                },
                {
                  "label": "Text (OPEN, TILTED, CLOSED)",
                  "value": "text"
                }
              ]
            }
          ]
        }
      }
    },
    "lights": {
      "type": "panel",
      "label": "Lights",
      "items": {
        "lightsHint": {
          "type": "staticText",
          "text": "One row per device. Rows with the same name and room become one lamp (for example several LED strips). A room that does not exist in the room list shows the lamp under 'More lights'.",
          "xs": 12
        },
        "lights": {
          "type": "table",
          "xs": 12,
          "items": [
            {
              "type": "text",
              "attr": "name",
              "title": "Name",
              "width": "16%",
              "filter": false,
              "sort": false,
              "default": ""
            },
            {
              "type": "text",
              "attr": "room",
              "title": "Room",
              "width": "12%",
              "filter": false,
              "sort": false,
              "default": ""
            },
            {
              "type": "objectId",
              "attr": "on",
              "title": "On/off",
              "width": "22%",
              "filter": false,
              "sort": false,
              "default": ""
            },
            {
              "type": "objectId",
              "attr": "level",
              "title": "Brightness",
              "width": "22%",
              "filter": false,
              "sort": false,
              "default": ""
            },
            {
              "type": "number",
              "attr": "levelMax",
              "title": "Brightness max",
              "width": "8%",
              "filter": false,
              "sort": false,
              "default": 100
            },
            {
              "type": "objectId",
              "attr": "reachable",
              "title": "Reachable",
              "width": "20%",
              "filter": false,
              "sort": false,
              "default": ""
            }
          ]
        }
      }
    },
    "shutters": {
      "type": "panel",
      "label": "Shutters",
      "items": {
        "shuttersHint": {
          "type": "staticText",
          "text": "One row per shutter. The room must match a name in the room list.",
          "xs": 12
        },
        "shutters": {
          "type": "table",
          "xs": 12,
          "items": [
            {
              "type": "text",
              "attr": "room",
              "title": "Room",
              "width": "16%",
              "filter": false,
              "sort": false,
              "default": ""
            },
            {
              "type": "text",
              "attr": "name",
              "title": "Name",
              "width": "16%",
              "filter": false,
              "sort": false,
              "default": ""
            },
            {
              "type": "objectId",
              "attr": "position",
              "title": "Position",
              "width": "38%",
              "filter": false,
              "sort": false,
              "default": ""
            },
            {
              "type": "number",
              "attr": "max",
              "title": "Value range up to",
              "width": "12%",
              "filter": false,
              "sort": false,
              "default": 100
            },
            {
              "type": "select",
              "attr": "closedAt",
              "title": "Fully closed is",
              "width": "18%",
              "filter": false,
              "sort": false,
              "default": "max",
              "options": [
                {
                  "label": "the highest value",
                  "value": "max"
                },
                {
                  "label": "0",
                  "value": "min"
                }
              ]
            }
          ]
        }
      }
    },
    "weather": {
      "type": "panel",
      "label": "Weather, waste, dishwasher",
      "items": {
        "weatherInstance": {
          "type": "instance",
          "adapter": "openweathermap",
          "allowDeactivate": true,
          "label": "Weather (openweathermap adapter)",
          "xs": 12,
          "md": 6
        },
        "weatherHourly": {
          "type": "checkbox",
          "label": "Hourly rain and temperature from Open-Meteo",
          "help": "Asks open-meteo.com (free, no key) every 30 minutes with the location from the system settings",
          "xs": 12,
          "md": 6
        },
        "trashInstance": {
          "type": "instance",
          "adapter": "trashschedule",
          "allowDeactivate": true,
          "label": "Waste collection (trashschedule adapter)",
          "xs": 12,
          "md": 6,
          "newLine": true
        },
        "dishwasherDevice": {
          "type": "objectId",
          "label": "Dishwasher (homeconnect adapter)",
          "xs": 12,
          "md": 6,
          "help": "Pick the device, for example homeconnect.0.0123456789",
          "newLine": true
        }
      }
    },
    "energy": {
      "type": "panel",
      "label": "Energy",
      "items": {
        "energyHint": {
          "type": "staticText",
          "text": "All values are optional. Power in watts, battery in percent, today's values in kWh.",
          "xs": 12
        },
        "energySolar": {
          "type": "objectId",
          "label": "Solar power (W)",
          "xs": 12,
          "md": 6
        },
        "energyConsumption": {
          "type": "objectId",
          "label": "House consumption (W)",
          "xs": 12,
          "md": 6
        },
        "energyGridImport": {
          "type": "objectId",
          "label": "Power from the grid (W)",
          "xs": 12,
          "md": 6
        },
        "energyGridExport": {
          "type": "objectId",
          "label": "Power fed into the grid (W)",
          "xs": 12,
          "md": 6
        },
        "energyBatteryLevel": {
          "type": "objectId",
          "label": "Battery level (%)",
          "xs": 12,
          "md": 6
        },
        "energyBatteryCharge": {
          "type": "objectId",
          "label": "Battery charging (W)",
          "xs": 12,
          "md": 6
        },
        "energyBatteryDischarge": {
          "type": "objectId",
          "label": "Battery discharging (W)",
          "xs": 12,
          "md": 6
        },
        "energySolarToday": {
          "type": "objectId",
          "label": "Solar today (kWh)",
          "xs": 12,
          "md": 6,
          "newLine": true
        },
        "energyConsumptionToday": {
          "type": "objectId",
          "label": "Consumption today (kWh)",
          "xs": 12,
          "md": 6
        },
        "energyGridToday": {
          "type": "objectId",
          "label": "From the grid today (kWh)",
          "xs": 12,
          "md": 6
        },
        "energySavings": {
          "type": "objectId",
          "label": "Money saved so far (€)",
          "xs": 12,
          "md": 6,
          "newLine": true
        },
        "energyTotal": {
          "type": "objectId",
          "label": "Energy produced so far (kWh)",
          "xs": 12,
          "md": 6
        },
        "energySolarMax": {
          "type": "number",
          "label": "Solar ring full at (W)",
          "default": 2700,
          "xs": 12,
          "md": 3,
          "newLine": true
        },
        "energyHomeMax": {
          "type": "number",
          "label": "House ring full at (W)",
          "default": 1300,
          "xs": 12,
          "md": 3
        },
        "energyTitle": {
          "type": "text",
          "label": "Title",
          "help": "Empty: Energy centre",
          "xs": 12,
          "md": 6
        },
        "energyHistoryUrl": {
          "type": "text",
          "label": "Folder with history files",
          "help": "Optional, for the history dialog (format: docs/energy-history.md), e.g. http://192.168.1.10/energie",
          "xs": 12,
          "newLine": true
        }
      }
    },
    "shopping": {
      "type": "panel",
      "label": "Shopping lists",
      "items": {
        "shoppingHint": {
          "type": "staticText",
          "text": "Bring! lists from the bring adapter: pick the 'content' datapoint of each list.",
          "xs": 12
        },
        "shoppingLists": {
          "type": "table",
          "xs": 12,
          "items": [
            {
              "type": "text",
              "attr": "name",
              "title": "Name",
              "width": "30%",
              "filter": false,
              "sort": false,
              "default": ""
            },
            {
              "type": "objectId",
              "attr": "content",
              "title": "List (content datapoint)",
              "width": "70%",
              "filter": false,
              "sort": false,
              "default": ""
            }
          ]
        }
      }
    }
  }
}
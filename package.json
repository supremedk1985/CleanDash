{
  "name": "iobroker.cleandash",
  "version": "0.4.0",
  "description": "A clean, ready-made dashboard for wall tablets: pick your datapoints, no design work",
  "author": {
    "name": "Daniel Korte",
    "email": "korte.daniel@outlook.de"
  },
  "homepage": "https://github.com/supremedk1985/CleanDash",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "dashboard",
    "tablet",
    "kiosk",
    "visualization"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/supremedk1985/CleanDash.git"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "files": [
    "admin/",
    "www/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
